KC_IMAGE=ghcr.io/igaw/artifactorial:latest
KC_POSTGRES_IMAGE=postgres:18-alpine
KC_FRONT_PORT=8002
# Local/standalone `docker-compose up` defaults only -- a real deploy
# (see homelab's roles/artifactorial) overrides these three with a
# vaulted password, same as it already does for the vars above.
KC_POSTGRES_DB=artifactorial
KC_POSTGRES_USER=artifactorial
KC_POSTGRES_PASSWORD=artifactorial-password
